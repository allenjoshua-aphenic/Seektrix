# ── Supabase (required) ─────────────────────────────────────────────────────
# Project URL (https://<ref>.supabase.co) and keys from Dashboard → Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS; used by server.ts and the Python ingestion scripts.
# NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Server ──────────────────────────────────────────────────────────────────
# Port for the Express server (serves the SPA and /api/*). Render sets PORT itself.
PORT=3000
# Only when the frontend is hosted separately from the API (e.g. Vercel + Render):
# the browser will call `${VITE_API_URL}/api/...`. Leave empty for same-origin.
VITE_API_URL=
# Optional allow-list of browser origins for the API (comma-separated). Empty = any origin.
CORS_ORIGIN=
# Optional: lets `node scripts/deploy_search_function.mjs` run SQL via the Management API
# (Dashboard → Account → Access Tokens). Alternative to DATABASE_URL below.
SUPABASE_ACCESS_TOKEN=

# ── Optional: direct Postgres connection for maintenance scripts ────────────
# Dashboard → Connect → Session pooler URI (includes the DB password).
# Lets a developer run SQL files such as database/search_holders_v2.sql from the CLI.
DATABASE_URL=

# ── Unused leftovers from an earlier design (safe to delete) ────────────────
GEMINI_API_KEY=
ENVIRONMENT=production
